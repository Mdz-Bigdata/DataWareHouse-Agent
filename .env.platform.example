# Run ./platform.sh init to create .env.platform with unique private credentials.
# This example is documentation, not a ready-to-use credentials file.
PLATFORM_MYSQL_ROOT_PASSWORD=generate_with_platform_init
DATA_API_ENCRYPTION_KEY=generate_with_platform_init
AGENTS_ENCRYPTION_KEY=generate_with_platform_init
DATA_API_ADMIN_API_KEY=generate_with_platform_init
AGENTS_ADMIN_API_KEY=generate_with_platform_init
DATA_ENGINE_SERVICE_TOKEN=generate_with_platform_init

# ---------------------------------------------------------------------------
# Published host ports (left-hand side of the Compose port mappings only; the
# container ports are fixed by the images and are not configurable here).
# The defaults below are the historical ports - keep them unless a port is
# already taken on this machine, e.g. `lsof -nP -iTCP:8000 -sTCP:LISTEN`.
# The common case is 8000: ./start.sh runs the local dev backend there, so set
# PLATFORM_CORE_BACKEND_PORT to a free port to run both stacks side by side.
PLATFORM_GATEWAY_PORT=8080
PLATFORM_CORE_BACKEND_PORT=8000
PLATFORM_CORE_WEB_PORT=3000
PLATFORM_DATA_API_PORT=8020
PLATFORM_AGENTS_PORT=8030
PLATFORM_AUDIO_WEB_PORT=8040
# Backing stores. Published for host-side inspection only - the services find
# each other by Compose service name, so remapping these breaks nothing inside.
PLATFORM_REDIS_PORT=6379
PLATFORM_QDRANT_PORT=6333
PLATFORM_ELASTICSEARCH_PORT=9200
# After changing PLATFORM_DATA_API_PORT / PLATFORM_AGENTS_PORT /
# PLATFORM_AUDIO_WEB_PORT, also set the matching PLATFORM_*_UI_URL below:
# the gateway's empty-value fallback still points browsers at 8020/8030/8040.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Embedding backend (the `embedding` service). It is in the "full" profile
# because audio's /ready calls aembed_query() and cannot stub it: without this
# container the platform gateway reports the audio subsystem degraded even
# though its five other dependencies are green. Everything below is optional -
# the values shown are exactly the defaults compose.yaml applies when unset.
# It publishes no host port; audio reaches it as embedding:80 on the Compose
# network, which also keeps it clear of the ports this platform already
# occupies (3000/6333/6379/8010/8020/8030/8040/8080/9200).
#
# What including it in `./platform.sh up-full` costs, before you tune anything:
#   - The FIRST start downloads ~1.3GB of weights into the embedding-cache
#     volume, which takes minutes. Later starts read that cache; deleting the
#     volume (docker volume rm <project>_embedding-cache) forces a refetch.
#   - The image is linux/amd64 only, so on Apple Silicon it runs emulated:
#     slow to load the model, heavy on CPU while it does.
#   - Nothing depends_on it, by design. While it boots - or if it never comes
#     up - only the audio subsystem's /ready stays degraded; the other 16
#     services start and run normally.

# Hard memory ceiling (docker mem_limit): ~1.3GB of fp32 weights resident plus
# per-batch activations that grow with MAX_BATCH_TOKENS. The Docker VM has
# 7.7GiB and the other 16 services sit at ~3.2GiB, so 3g leaves real slack.
# Too low and the container is OOM-killed mid-batch (exit 137); too high and
# one large batch can starve elasticsearch/mysql. Lower MAX_BATCH_TOKENS first.
AUDIO_EMBEDDING_MEM_LIMIT=3g
AUDIO_EMBEDDING_MEM_RESERVATION=512m
# CPU ceiling. Emulated amd64 will use every core it is handed while loading
# the model, and this host has 16. Raising it shortens the cold start at the
# cost of everything else running on the machine during that window.
AUDIO_EMBEDDING_CPUS=4
# Healthcheck grace period; must cover the emulated boot plus the first-run
# download. Only ever raise it: a value that is too short merely shows the
# container as unhealthy in `docker ps` - it gates nothing and blocks nothing.
AUDIO_EMBEDDING_START_PERIOD=900s

# Image platform. linux/amd64 is the only one upstream publishes for the cpu-*
# tags (no arm64 manifest exists), so leaving this alone is correct even on
# Apple Silicon - changing it only makes the pull fail.
AUDIO_EMBEDDING_PLATFORM=linux/amd64
# Model. Changing it REQUIRES setting AUDIO_EMBEDDING_SIZE to the new model's
# output dimension and re-creating the Qdrant collections, which are created
# with that vector size; mismatched sizes fail at insert time, not at start.
AUDIO_EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
AUDIO_EMBEDDING_SIZE=1024
# Throughput knobs. Both raise peak memory, so revisit AUDIO_EMBEDDING_MEM_LIMIT
# when raising either.
AUDIO_EMBEDDING_MAX_CONCURRENT=16
AUDIO_EMBEDDING_MAX_BATCH_TOKENS=16384
# Weight download endpoint, for restricted networks. Any mirror must serve
# Content-Range responses, or TEI's downloader aborts with
# "Header content-range is missing" (hf-mirror.com has failed exactly this way
# here). Leave at the upstream hub when it is reachable.
AUDIO_EMBEDDING_HF_ENDPOINT=https://huggingface.co
# Fully offline alternative: place the model on disk, bind-mount that directory
# into the container and point AUDIO_EMBEDDING_MODEL_ID at the in-container
# path. The mount is not in compose.yaml because it cannot be made conditional
# there; apps/listen-book-data-agent/infra/compose.yaml shows the upstream form.
# Note that BAAI/bge-large-zh-v1.5 ships pytorch_model.bin only (no
# safetensors), so a config+tokenizer-only copy of the directory is not enough.
# ---------------------------------------------------------------------------

# The one-command local launcher starts a dedicated persistent PostgreSQL warehouse.
# Existing business .env settings are preserved. These credentials never reuse NanZi MySQL.
WAREHOUSE_POSTGRES_PASSWORD=generate_with_platform_init
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_DB=datawarehouse
WAREHOUSE_POSTGRES_PORT=55432

# Empty UI URLs use the visitor's hostname and native ports 8020 / 8030.
# Set full public HTTPS URLs when using reverse proxies or external hostnames,
# or when PLATFORM_DATA_API_PORT / PLATFORM_AGENTS_PORT / PLATFORM_AUDIO_WEB_PORT
# no longer use their default values.
PLATFORM_CORE_UI_URL=
PLATFORM_DATA_API_UI_URL=
PLATFORM_AGENTS_UI_URL=
PLATFORM_AUDIO_UI_URL=
PLATFORM_DATA_ENGINE_UI_URL=
# Browser-facing URL of the agents platform: keep the port equal to
# PLATFORM_AGENTS_PORT. Leave unset to inherit http://localhost:<that port>.
AGENTS_PUBLIC_URL=http://localhost:8030

# Optional Compose-network upstream overrides. Native container ports differ
# from browser-facing ports; keep these defaults for the bundled applications.
PLATFORM_CORE_URL=http://core-backend:8000
PLATFORM_DATA_API_URL=http://data-api:8000
PLATFORM_AGENTS_URL=http://agents:8001
PLATFORM_AUDIO_URL=http://audio:8000
PLATFORM_DATA_ENGINE_URL=http://data-engine:8050

# The adapter is reachable only through the same-origin gateway, which injects
# DATA_ENGINE_SERVICE_TOKEN server-side. Enable writes only for trusted operators.
PLATFORM_DATA_ENGINE_ENABLED=true
DATA_ENGINE_ALLOW_HTTP_MUTATIONS=false
DATA_ENGINE_SCHEDULER_URL=http://agents:8001/api/v1/tasks/
DATA_AGENT_ONTOLOGY_STORE=yaml
DATA_AGENT_TOKEN_TTL=300

# Optional existing business data source key, created in the Data API platform.
# Leave blank until a real source is registered; upstream sample sources are disabled.
DATA_PLATFORM_DATA_SOURCE=

# Optional external MySQL overrides: DATA_API_MYSQL_HOST/PORT/DB/USER/PASSWORD,
# AGENTS_MYSQL_HOST/PORT/DB/USER/PASSWORD. External databases must already exist
# and be empty for automated first-time initialization. Existing unmanaged
# schemas require manual migration/adoption; the initializer does not reset them.
