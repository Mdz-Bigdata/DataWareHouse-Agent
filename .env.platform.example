# Run ./platform.sh init to create .env.platform with unique private credentials.
# This example is documentation, not a ready-to-use credentials file.
PLATFORM_MYSQL_ROOT_PASSWORD=generate_with_platform_init
DATA_API_ENCRYPTION_KEY=generate_with_platform_init
AGENTS_ENCRYPTION_KEY=generate_with_platform_init
DATA_API_ADMIN_API_KEY=generate_with_platform_init
AGENTS_ADMIN_API_KEY=generate_with_platform_init

# The one-command local launcher starts a dedicated persistent PostgreSQL warehouse.
# Existing business .env settings are preserved. These credentials never reuse NanZi MySQL.
WAREHOUSE_POSTGRES_PASSWORD=generate_with_platform_init
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_DB=datawarehouse
WAREHOUSE_POSTGRES_PORT=55432

# Empty UI URLs use the visitor's hostname and native ports 8020 / 8030.
# Set full public HTTPS URLs when using reverse proxies or external hostnames.
PLATFORM_CORE_UI_URL=
PLATFORM_DATA_API_UI_URL=
PLATFORM_AGENTS_UI_URL=
PLATFORM_AUDIO_UI_URL=
AGENTS_PUBLIC_URL=http://localhost:8030

# Optional Compose-network upstream overrides. Native container ports differ
# from browser-facing ports; keep these defaults for the bundled applications.
PLATFORM_CORE_URL=http://core-backend:8000
PLATFORM_DATA_API_URL=http://data-api:8000
PLATFORM_AGENTS_URL=http://agents:8001
PLATFORM_AUDIO_URL=http://audio:8000

# Optional existing business data source key, created in the Data API platform.
# Leave blank until a real source is registered; upstream sample sources are disabled.
DATA_PLATFORM_DATA_SOURCE=

# Optional external MySQL overrides: DATA_API_MYSQL_HOST/PORT/DB/USER/PASSWORD,
# AGENTS_MYSQL_HOST/PORT/DB/USER/PASSWORD. External databases must already exist
# and be empty for automated first-time initialization. Existing unmanaged
# schemas require manual migration/adoption; the initializer does not reset them.
