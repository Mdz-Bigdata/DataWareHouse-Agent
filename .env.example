# =====================================================================
# 智能问数系统多数据源配置模板 (.env.example)
# 使用方法: 复制该文件并重命名为 .env，修改对应的值即可生效
# =====================================================================

# 1. 物理数据库类型：可选 mysql / postgresql / clickhouse / doris / starrocks
DB_TYPE=postgresql
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blog_converter

# 2. 数据库连接串 URL (将自动通过 SQLAlchemy 进行连接池托管)
#
#   - MySQL 示例 (需要安装 pymysql 驱动):
#     DB_URL=mysql+pymysql://username:password@host:port/database_name?charset=utf8mb4
#
#   - PostgreSQL 示例 (需要安装 psycopg2 驱动):
#     DB_URL=postgresql+psycopg2://username:password@host:port/database_name
#
#   - ClickHouse 示例 (需要安装 clickhouse-connect 驱动):
#     DB_URL=clickhouse+connect://username:password@host:port/database_name
#
#   - Doris 示例 (Doris 兼容 MySQL 协议，使用 mysql 驱动):
#     DB_TYPE=doris
#     DB_URL=mysql+pymysql://username:password@host:port/database_name
#
#   - StarRocks 示例 (StarRocks 兼容 MySQL 协议，使用 mysql 驱动):
#     DB_TYPE=starrocks
#     DB_URL=mysql+pymysql://username:password@host:port/database_name
#
# DB_URL=mysql+pymysql://root:password123@localhost:3306/dw_store?charset=utf8mb4

# 3. 连接池基础调优
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
