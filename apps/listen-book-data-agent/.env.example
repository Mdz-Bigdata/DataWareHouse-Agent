# Application environment: development | production (其他值如 staging 按 production 语义处理)
# 生产部署必须设为 production，否则启动期会因弱密钥/弱口令告警但放行。
APP_ENV=development

# Docker infrastructure
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_APP_USER=listenbook
MYSQL_APP_PASSWORD=change-this-app-password
MYSQL_PORT=23306
META_DB_NAME=listenbook_meta
QDRANT_PORT=16433
QDRANT_GRPC_PORT=16434
ES_PORT=19200
EMBEDDING_PORT=8081
EMBEDDING_MODEL_PATH=D:/models/bge-large-zh-v1.5

# Application database connections
# AUDIO_DB_USER: 初始化/管理员账号，用于 tools.audio_data.bootstrap 建库导数
AUDIO_DB_HOST=127.0.0.1
AUDIO_DB_PORT=23306
AUDIO_DB_USER=root
AUDIO_DB_PASSWORD=change-this-root-password
AUDIO_DB_NAME=audio
# AUDIO_QUERY_USER: 应用运行时使用的只读账号，仅授予 audio.* SELECT 权限
AUDIO_QUERY_USER=listenbook_reader
AUDIO_QUERY_PASSWORD=change-this-reader-password
META_DB_HOST=127.0.0.1
META_DB_PORT=23306
META_DB_USER=listenbook
META_DB_PASSWORD=change-this-app-password

# Search and embedding services
QDRANT_HOST=127.0.0.1
ES_HOST=127.0.0.1
EMBEDDING_HOST=127.0.0.1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# OpenAI-compatible chat endpoint
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-local-secret
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
# 供应商 API Key 落库加密的主密钥（生产必须显式设置）
LLM_KEY_MASTER_SECRET=replace-with-random-64-hex

# Query guardrails
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=500
SQL_CORRECTION_ATTEMPTS=2

# Auth (JWT signing + bootstrap admin)
# AUTH_SECRET_KEY 用于 HS256 签名，生产必须 ≥ 32 字节（推荐 48+）。
#   生成示例（PowerShell）：  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   生成示例（Bash）：        openssl rand -base64 48
#   占位值会被启动期校验拒绝（APP_ENV=production 时）或告警（APP_ENV=development 时）。
AUTH_SECRET_KEY=replace-with-random-64-hex
AUTH_TOKEN_TTL_MINUTES=720
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
