# =============================================================================
# ADAS 闭环湖仓 · 环境变量样例
#
#   cp .env.example .env
#   docker compose --env-file .env -f docker/compose.yaml up -d
#
# 本文件列出了**代码里所有会读的环境变量**。除端口外，每一项的值都逐字等于代码里
# 的默认值（少数几个例外已在行内注明原因）。端口则统一改成了 186xx 宿主机号段，
# 原因见下面那段。也就是说：这份文件原样复制成 .env 才能连上本地栈。
#
# 三个分区：
#   [1] config.py            —— 数据面外部依赖（MinIO/Paimon/Flink/StarRocks/Neo4j/Kafka）
#   [2] 其它模块读的环境变量 —— CDC 源库、控制面本地存储、向量子系统
#   [3] compose 专用         —— 只给 docker 用，Python 代码一个都不读
#
# =============================================================================
# ⚠️⚠️ 宿主机端口号段：186xx —— 改端口前必读
#
#   本项目**独占 186xx 宿主机端口号段**，为的是避开同一仓库里的平台
#   （DataWareHouse-Agent 的 compose.yaml 已经发布 8080/8000/3000/8020/8030/
#   8040/6379/6333/9200）。平台是既有的、不动它；本项目让路。
#
#   **容器端口保持各组件原生默认值不变**（9000/9001/3306/9030/8030/8040/
#   7474/7687/6379/8081/8083/9092）。迁移只发生在「宿主机发布端口」这一侧，
#   也就是 compose ports 映射的左半边、以及本文件里这些给宿主机客户端用的 URL。
#   compose 网络内服务间互访走「服务名 + 容器端口」，与本文件无关，不要照抄。
#
#   宿主机 → 容器 对照：
#       18600→9000  MinIO S3          18601→9001  MinIO Console
#       18606→3306  MySQL(CDC 源 + 控制面本地库)
#       18630→9030  StarRocks 查询     18631→8030  StarRocks FE HTTP
#       18640→8040  StarRocks BE HTTP
#       18674→7474  Neo4j Browser      18687→7687  Neo4j Bolt
#       18679→6379  Redis(控制面)
#       18681→8081  Flink Web UI       18683→8083  Flink SQL Gateway
#       18692→9092  Kafka
#
#   ⚠️ 因此本文件里的端口值**不再等于 config.py 的默认值**（那些默认值仍是各
#      组件的原生端口）。这是本文件唯一一处刻意偏离代码默认值的地方：
#      不设 .env 直接裸跑 Python，连的会是原生端口，连不上本地栈。
# =============================================================================
#
# ⚠️ localhost 的含义：这些值面向**宿主机上跑的 Python**，端口一律用 186xx。
#    容器内部的 localhost 是容器自己，compose 里已用服务名 + 容器端口
#    （minio:9000 / kafka:29092 / mysql:3306 / starrocks:9030 / neo4j:7687）
#    覆盖，不需要你在这里改。
#    详见 docker/README.md。
#
# ⚠️ 这里的口令是本地开发用的弱口令。生产环境一律走 secret 机制注入，
#    不要把真实口令提交进仓库。
# =============================================================================


# =============================================================================
# [1] config.py —— 数据面外部依赖
#     来源：src/adas_lakehouse/config.py，每个 _env / _env_int 都在这里
# =============================================================================

# --- MinIO：Paimon warehouse 与合规入湖的原始文件（config.MinioConfig）------
# 宿主机发布端口 18600 → 容器 9000（与 config.MinioConfig 的默认值一致，写在这里只为显式）
MINIO_ENDPOINT=http://localhost:18600
MINIO_ACCESS_KEY=adas
MINIO_SECRET_KEY=adas-secret
# warehouse_path = s3://${PAIMON_WAREHOUSE_BUCKET}/warehouse
PAIMON_WAREHOUSE_BUCKET=adas-lakehouse
RAW_BUCKET=adas-raw

# --- Paimon 目录结构（config.PaimonConfig）----------------------------------
# metastore=filesystem：元数据与数据同放对象存储，不依赖 Hive Metastore，
# 这是「一套存储、双引擎读」（Flink 写 / StarRocks 直查）的前提。
PAIMON_CATALOG=paimon
PAIMON_DATABASE=adas_lakehouse
PAIMON_METASTORE=filesystem

# --- Flink（config.FlinkConfig）---------------------------------------------
# 18681 → 容器 8081，18683 → 容器 8083
FLINK_JOBMANAGER_URL=http://localhost:18681
FLINK_SQL_GATEWAY_URL=http://localhost:18683
FLINK_PARALLELISM=2
# checkpoint 是 CDC 断点续传的载体：调小增加小文件，调大拉长故障恢复的重放窗口
FLINK_CHECKPOINT_INTERVAL_MS=60000

# --- StarRocks：双路查询（config.StarRocksConfig）---------------------------
STARROCKS_FE_HOST=localhost
# 18630 → 容器 9030；FE HTTP 用 18631（18630 已被查询口占用，故顺延 31）
STARROCKS_QUERY_PORT=18630
STARROCKS_HTTP_PORT=18631
STARROCKS_USER=root
# allin1 镜像的 root 默认无口令，与 config.py 的默认值（空串）一致
STARROCKS_PASSWORD=
# External Catalog 直查 Paimon；内表库放毫秒级直查与向量检索
STARROCKS_EXTERNAL_CATALOG=paimon_catalog
STARROCKS_DATABASE=adas_ads

# --- Neo4j：血缘图库（config.Neo4jConfig）-----------------------------------
# 18687 → 容器 7687（Neo4j Browser 在 http://localhost:18674）
NEO4J_URI=bolt://localhost:18687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adas-lineage
NEO4J_DATABASE=neo4j
# 多跳遍历限 3-5 跳防扇出爆炸
NEO4J_MAX_DEPTH=5

# --- Kafka：三通道入湖里的实时通道（config.KafkaConfig）---------------------
# 18692 → 容器 9092；与 compose 里 KAFKA_ADVERTISED_LISTENERS 的
# PLAINTEXT_HOST://localhost:18692 必须对得上，否则宿主机客户端拿到元数据后连不回来
KAFKA_BOOTSTRAP_SERVERS=localhost:18692
KAFKA_GROUP_ID=adas-lakehouse
KAFKA_TRIGGER_TOPIC=vehicle.trigger.event
KAFKA_PRODUCTION_TOPIC=production.event


# =============================================================================
# [2] 其它模块读的环境变量
#     config.py 只管数据面外部依赖，下面这些各自散在子系统里
# =============================================================================

# --- 通道一 CDC 源库（src/adas_lakehouse/ingest/channels.py）----------------
# 三个业务库：collect_platform / vehicle_platform / config_platform
CDC_MYSQL_HOSTNAME=localhost
# 18606 → 容器 3306
CDC_MYSQL_PORT=18606
CDC_MYSQL_USERNAME=adas
# ⚠️ 代码默认是空串（刻意不给口令，逼你显式配）。下面给的是本地栈的值，
#    与 compose 创建 MySQL 账号时用的是同一个变量，改一处即可。
CDC_MYSQL_PASSWORD=adas-secret
# server-id 区间要能容下并行快照的并发度，别和真实从库撞号
CDC_MYSQL_SERVER_ID=5400-5404

# --- 通道三 文件元信息 topic（ingest/channels.py）---------------------------
KAFKA_FILE_META_TOPIC=collect.file.meta

# --- 控制面本地存储（src/adas_lakehouse/controlplane/store.py）--------------
# 「平台自身运行态」：规则配置、任务与执行状态、审核流状态。可随时重建。
CONTROL_PLANE_MYSQL_HOST=localhost
# 与 CDC 同一个 MySQL 实例，宿主机同样是 18606
CONTROL_PLANE_MYSQL_PORT=18606
CONTROL_PLANE_MYSQL_USER=adas
# ⚠️ 同 CDC_MYSQL_PASSWORD：代码默认空串，这里给本地栈的值
CONTROL_PLANE_MYSQL_PASSWORD=adas-secret
CONTROL_PLANE_MYSQL_DATABASE=adas_mining_platform
CONTROL_PLANE_REDIS_HOST=localhost
# 18679 → 容器 6379（旧的 6379 被同仓平台占着，这是本次冲突点之一）
CONTROL_PLANE_REDIS_PORT=18679
CONTROL_PLANE_REDIS_DB=0

# --- 向量子系统（src/adas_lakehouse/vector/params.py）-----------------------
# ⚠️ 这一组几乎都是「原文未明确、本项目设计」的默认值，改之前先读 params.py 的注释。
# CLIP ViT-B/32 的 512 维；换模型必须同步改 embedding_version 与索引 dim 属性
VECTOR_EMBEDDING_DIM=512
# HNSW 索引参数（度量方式固定 cosine_similarity，原文明确，不可配）
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=200
VECTOR_HNSW_EF_SEARCH=128
# 检索 topK
VECTOR_DEFAULT_TOP_K=50
VECTOR_MAX_TOP_K=1000
# 图文融合权重，两者之和必须为 1.0
VECTOR_FUSION_IMAGE_WEIGHT=0.5
VECTOR_FUSION_TEXT_WEIGHT=0.5
# 成本分级：普通数据的抽样比例
VECTOR_NORMAL_SAMPLE_RATIO=0.1
# GPU 空闲时段起点（小时）与批量化参数
VECTOR_GPU_WINDOW_START_HOUR=0
VECTOR_EMBEDDING_BATCH_SIZE=256
VECTOR_INDEX_BUILD_TIMEOUT_SEC=7200

# --- 表名覆盖（src/adas_lakehouse/mining/tables.py）-------------------------
# 每个 TableRef 都可以被 ADAS_TABLE_<表名大写> 覆盖，用于灰度/影子表，例如：
#   ADAS_TABLE_DWD_MINING_RESULT_DETAIL=dwd_mining_result_detail_shadow
# 默认全部不设，走代码里的表名。


# =============================================================================
# [3] compose 专用 —— Python 代码不读这些
# =============================================================================

# MySQL root 口令（只用于容器初始化与 healthcheck；业务账号用 CDC_MYSQL_* 那组）
MYSQL_ROOT_PASSWORD=adas-root

# Flink TaskManager 槽位数。作业并行度看 FLINK_PARALLELISM，这个是容量上限。
FLINK_TASK_SLOTS=4

# 血缘变更事件 topic（flink/sql/lineage_realtime_sync.sql 里写死 lineage.change.event，
# 这里只给 kafka-init 建 topic 用）
KAFKA_LINEAGE_TOPIC=lineage.change.event
